# #############################################################
# Dependencies (Never commit these; they are reinstalled via package.json)
# #############################################################
node_modules/
/jspm_packages/
/typings/

# #############################################################
# Production Builds (Generated outputs)
# #############################################################
/build/
/dist/
/out/
/.next/

# #############################################################
# Environment Variables & Secrets (CRITICAL: Protects private keys/API tokens)
# #############################################################
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local

# #############################################################
# Logs and Diagnostics
# #############################################################
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# #############################################################
# Testing & Coverage Artifacts
# #############################################################
/coverage/
/.jest/
*.lcov
.eslintcache
.stylelintcache

# #############################################################
# IDEs, Text Editors, and OS-Specific Files
# #############################################################
# Editor directories and files
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System files
.DS_Store
Thumbs.db

